# Plantilla SIN secretos. Los datos de AWS (hosts, ARN de los secretos) los escribe infra/crear_env.sh al desplegar.
AIRFLOW_UID=1000
AIRFLOW_UI_PORT=8080
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_FERNET_KEY=<se genera al azar en la EC2>
AIRFLOW_SECRET_KEY=<se genera al azar en la EC2>
AIRFLOW_ADMIN_PASSWORD=<se genera al azar en la EC2>
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<se genera al azar en la EC2>

AWS_REGION=us-east-2
S3_BUCKET=<bucket del data warehouse>
RDS_HOST=<endpoint de RDS MySQL>
RDS_SECRET_ARN=<ARN del secreto de RDS>
MYSQL_DATABASE=ecommerce
DOCDB_HOST=<endpoint del clúster de DocumentDB>
DOCDB_SECRET_ARN=<ARN del secreto de DocumentDB>
MONGO_DATABASE=ecommerce
REDSHIFT_HOST=<endpoint del clúster de Redshift>
REDSHIFT_SECRET_ARN=<ARN del secreto de Redshift>
REDSHIFT_IAM_ROLE_ARN=<ARN del rol que Redshift usa para leer S3>
REDSHIFT_DATABASE=dev
DAG_SCHEDULE=
