{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputoRedYBasesDeDatosEnUsEast2",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*", "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress", "ec2:CreateTags", "ec2:RunInstances", "ec2:TerminateInstances",
        "ec2:StartInstances", "ec2:StopInstances", "ec2:CreateKeyPair", "ec2:DeleteKeyPair", "ec2:ModifyInstanceMetadataOptions",
        "rds:CreateDBInstance", "rds:DeleteDBInstance", "rds:ModifyDBInstance", "rds:StartDBInstance", "rds:StopDBInstance",
        "rds:CreateDBCluster", "rds:DeleteDBCluster", "rds:StartDBCluster", "rds:StopDBCluster",
        "rds:CreateDBSubnetGroup", "rds:DeleteDBSubnetGroup", "rds:Describe*", "rds:AddTagsToResource", "rds:ListTagsForResource",
        "redshift:CreateCluster", "redshift:DeleteCluster", "redshift:ModifyCluster", "redshift:PauseCluster", "redshift:ResumeCluster",
        "redshift:CreateClusterSubnetGroup", "redshift:DeleteClusterSubnetGroup", "redshift:Describe*", "redshift:CreateTags"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Sid": "SecretosDelProyecto",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret", "secretsmanager:GetSecretValue", "secretsmanager:PutSecretValue",
        "secretsmanager:DescribeSecret", "secretsmanager:DeleteSecret", "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-2:*:secret:taller-dw/*"
    },
    {
      "Sid": "ListarSecretos",
      "Effect": "Allow",
      "Action": "secretsmanager:ListSecrets",
      "Resource": "*"
    },
    {
      "Sid": "RolesDelProyecto",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy",
        "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:DetachRolePolicy", "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile", "iam:GetInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": ["arn:aws:iam::*:role/taller-dw-*", "arn:aws:iam::*:instance-profile/taller-dw-*"]
    },
    {
      "Sid": "PasarSoloLosRolesDelProyecto",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/taller-dw-*"
    },
    {
      "Sid": "ListarRoles",
      "Effect": "Allow",
      "Action": "iam:ListRoles",
      "Resource": "*"
    },
    {
      "Sid": "RolesVinculadosAServicios",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {"StringEquals": {"iam:AWSServiceName": ["rds.amazonaws.com", "redshift.amazonaws.com"]}}
    },
    {
      "Sid": "ImagenDeAmazonLinux",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-2::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "BucketDelProyecto",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::bucket-taller-dw-*", "arn:aws:s3:::bucket-taller-dw-*/*"]
    },
    {
      "Sid": "ListarBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    }
  ]
}
